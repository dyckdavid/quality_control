# Copy to .env and replace every secret before the server is reachable
# from anything except this machine. Existing environment variables win
# over this file.

QC_HTTP_ADDR=127.0.0.1:8080
QC_DATABASE_URL=postgres://qc:replace-db-password@127.0.0.1:5432/quality_control?sslmode=disable
QC_JWT_SECRET=replace-with-openssl-rand-base64-48-characters
QC_ACCESS_TTL=15m
QC_REFRESH_TTL=168h
QC_CORS_ORIGINS=
QC_LOG_LEVEL=info
QC_DATA_DIR=./data
QC_TRUST_PROXY=false

# Used only when the users table is empty, then ignored.
QC_ADMIN_USERNAME=admin
QC_ADMIN_PASSWORD=change-me-now
QC_ADMIN_EMAIL=admin@localhost
QC_ADMIN_FULL_NAME=Administrator
